# Contoh variabel environment — salin ke .env lalu isi nilainya.
# JANGAN commit file .env asli ke git.

# Port server (produksi: 3000). Untuk smoke test lokal pakai 3100.
PORT=3000

# Mode Node: development | production
NODE_ENV=production

# Daftar Google `sub` (uid) admin, dipisah koma. Alternatif: ADMIN_EMAILS (daftar email admin).
# Contoh: ADMIN_UIDS=116111222333444555666
ADMIN_UIDS=

# Daftar email admin (alternatif ADMIN_UIDS), dipisah koma.
# Contoh: ADMIN_EMAILS=admin@puskesmasmanding.com
ADMIN_EMAILS=

# Google OAuth Client ID untuk login Google (Google Identity Services).
# Tanpa ini, login Google nonaktif (endpoint /api/auth/google menjawab 400).
GOOGLE_CLIENT_ID=

# Kunci Gemini AI (dipakai /api/ai/*)
GEMINI_API_KEY=

# --- WhatsApp Cloud API (opsional) ---
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_API_VERSION=v21.0
WHATSAPP_DEFAULT_COUNTRY_CODE=62
WHATSAPP_TEST_MODE=false
