# Contoh variabel environment — salin ke .env lalu isi nilainya.
# JANGAN commit file .env asli ke git.

# Port server (produksi: 3000). Untuk smoke test lokal pakai 3100.
PORT=3000

# Mode Node: development | production
NODE_ENV=production

# Daftar UID Firebase admin, dipisah koma. Alternatif: custom claim `admin: true`.
# Contoh: ADMIN_UIDS=uid1,uid2
ADMIN_UIDS=

# Service account Firebase Admin SDK (JSON string satu baris) untuk verifikasi ID Token.
# Tanpa ini, endpoint butuh-auth menjawab 503 (fail-closed).
FIREBASE_SERVICE_ACCOUNT_JSON=

# Kunci Gemini AI (dipakai /api/ai/*)
GEMINI_API_KEY=

# --- WhatsApp Cloud API (opsional) ---
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_API_VERSION=v21.0
WHATSAPP_DEFAULT_COUNTRY_CODE=62
WHATSAPP_TEST_MODE=false
