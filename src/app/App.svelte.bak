<!--
  @component Root aplikasi: inisialisasi auth & tema, mode pemeliharaan,
  pemeriksaan feature flags, pemuatan lazy per fitur, dan layout publik/admin.
-->
<script lang="ts">
  import { onMount } from 'svelte';
  import { routerState, matchRoute, type RouteDef } from './router.svelte.js';
  import { authStore } from '../shared/stores/auth.svelte.js';
  import { featureFlagsService } from '../shared/services/featureFlagsService.js';
  import { siteSettingsService } from '../shared/services/siteSettingsService.js';
  import type { SiteSettings } from '../shared/types/index.js';
  import ThemeStyleInjector from '../shared/components/ThemeStyleInjector.svelte';
  import ProtectedRoute from '../shared/components/ProtectedRoute.svelte';
  import ToastHost from '../shared/ui/ToastHost.svelte';
  import PublicLayout from '../shared/layout/PublicLayout.svelte';
  import AdminLayout from '../shared/layout/AdminLayout.svelte';
  import FeatureDisabledNotice from '../features/errors/FeatureDisabledNotice.svelte';
  import NotFoundPage from '../features/errors/NotFoundPage.svelte';
  import MaintenanceScreen from '../shared/components/MaintenanceScreen.svelte';
  import { AlertTriangle } from 'lucide-svelte';

  /** Pemetaan path → id navigasi aktif pada PublicLayout. */
  const ROUTE_NAV: Record<string, string> = {
    '/': 'home',
    '/profil': 'profil', '/sejarah-puskesmas': 'profil', '/visi-misi': 'profil',
    '/struktur-organisasi': 'profil', '/tenaga-kesehatan': 'profil', '/sarana-prasarana': 'profil',
    '/layanan': 'layanan',
    '/dokumen': 'dokumen',
    '/microsites': 'microsite',
    '/berita': 'berita', '/survei': 'survei', '/galeri': 'galeri',
    '/kontak': 'kontak', '/kritik-saran': 'kritik-saran',
  };

  let currentPath = $state('/');
  let disabledFeature = $state<{ label: string; disabledNotice?: string } | null>(null);
  let settings = $state<SiteSettings | null>(null);

  interface LoadedModule { def: RouteDef; component: unknown; params: Record<string, string> }
  let loaded = $state<LoadedModule | null>(null);
  let loadError = $state(false);

  const activeNav = $derived(ROUTE_NAV[currentPath] || 'home');

  // --- Mode pemeliharaan ---
  const isPublicRoute = $derived(!currentPath.startsWith('/admin') && currentPath !== '/login' && currentPath !== '/blueprint');
  const isMaintenanceActive = $derived(
    Boolean(settings?.maintenanceMode || (typeof localStorage !== 'undefined' && localStorage.getItem('puskesmas_maintenance_mode') === 'true'))
  );
  const isMicrositeRoute = $derived(currentPath === '/microsites' || currentPath.startsWith('/m/'));
  const isAllowedMicrosite = $derived(settings?.maintenanceAllowMicrositeAccess !== false && isMicrositeRoute);
  const showMaintenanceScreen = $derived.by(() => {
    if (!isMaintenanceActive || !isPublicRoute || isAllowedMicrosite) return false;
    const isAdminLoggedIn = Boolean(authStore.user);
    const allowAdminBypass = settings?.allowAdminAccessDuringMaintenance !== false;
    return !isAdminLoggedIn || !allowAdminBypass;
  });
  const showMaintenanceBanner = $derived(isMaintenanceActive && isPublicRoute && !showMaintenanceScreen && authStore.user);

  function resolveRoute() {
    // Periksa feature flags terlebih dahulu
    const check = featureFlagsService.checkPathAccess(currentPath);
    if (!check.allowed) {
      disabledFeature = check.featureMeta
        ? { label: check.featureMeta.label, disabledNotice: check.featureMeta.disabledNotice }
        : { label: '' };
      loaded = null;
      loadError = false;
      return;
    }
    disabledFeature = null;

    const match = matchRoute(currentPath);
    if (!match) {
      // Slug dinamis halaman CMS (mis. /sejarah-puskesmas, /visi-misi)
      if (currentPath.length > 1 && !currentPath.startsWith('/admin')) {
        matchRouteDynamicPage();
        return;
      }
      loaded = null;
      loadError = false;
      return;
    }
    loadError = false;
    match.def
      .load()
      .then((mod) => {
        // Abaikan hasil bila pengguna sudah pindah rute
        if (routerState.path !== currentPath) return;
        loaded = { def: match.def, component: (mod as { default: unknown }).default, params: match.params };
      })
      .catch((err) => {
        console.error('Gagal load rute:', currentPath, err);
        if (routerState.path === currentPath) loadError = true;
      });
  }

  /** Slug CMS dinamis dirender DynamicPageRenderer dari fitur profil. */
  function matchRouteDynamicPage() {
    import('../features/profil/DynamicPageRenderer.svelte')
      .then((mod) => {
        if (routerState.path !== currentPath) return;
        loaded = {
          def: { path: currentPath, load: () => Promise.resolve(mod), layout: 'public' },
          component: mod.default,
          params: {},
        };
      })
      .catch(() => {
        if (routerState.path === currentPath) loadError = true;
      });
  }

  onMount(() => {
    const cleanup = routerState.init();
    authStore.init();
    siteSettingsService.getSettings().then((s) => { settings = s; });
    const handleSettingsChange = () => siteSettingsService.getSettings().then((s) => { settings = s; });
    window.addEventListener('puskesmas_settings_updated', handleSettingsChange);
    window.addEventListener('storage', handleSettingsChange);
    return () => {
      cleanup();
      window.removeEventListener('puskesmas_settings_updated', handleSettingsChange);
      window.removeEventListener('storage', handleSettingsChange);
    };
  });

  // Sinkronkan path hash → resolve rute (lazy load per fitur)
  $effect(() => {
    currentPath = routerState.path;
    resolveRoute();
  });

  const PageComponent = $derived(loaded?.component as import('svelte').Component | undefined);
  const pageParams = $derived(loaded?.params ?? {});
  const layout = $derived(loaded?.def.layout ?? 'public');
  const permission = $derived(loaded?.def.permission);
</script>

<ThemeStyleInjector />

{#if showMaintenanceScreen}
  <MaintenanceScreen {settings} />
{:else}
  {#if showMaintenanceBanner}
    <div
      class="bg-rose-600 text-white px-4 py-2.5 text-xs font-semibold flex flex-col sm:flex-row items-center justify-between gap-2 shadow-lg sticky top-0 z-50"
    >
      <div class="flex items-center gap-2">
        <AlertTriangle class="w-4 h-4 text-white shrink-0" />
        <span>
          <strong>MODE PEMELIHARAAN AKTIF:</strong> Pengunjung umum saat ini melihat layar pemeliharaan. Anda sedang melihat
          pratinjau situs sebagai Administrator ({authStore.user?.email}).
        </span>
      </div>
      <div class="flex items-center gap-2 shrink-0">
        <a
          href="#/admin/settings"
          class="px-3 py-1 bg-white text-rose-700 rounded-xl text-xs font-bold hover:bg-rose-50 transition shadow-xs"
        >
          Kelola di Pengaturan
        </a>
      </div>
    </div>
  {/if}

  {#if disabledFeature}
    <FeatureDisabledNotice featureMeta={disabledFeature.label ? disabledFeature : undefined} />
  {:else if loadError}
    <PublicLayout activeNav={activeNav}>
      <NotFoundPage />
    </PublicLayout>
  {:else if loadError}
    <div class="min-h-screen flex flex-col items-center justify-center gap-3 p-8 text-center">
      <div class="text-4xl">⚠️</div>
      <h2 class="text-lg font-bold">Gagal memuat halaman</h2>
      <p class="text-sm text-gray-600">Path: {currentPath}</p>
      <p class="text-xs text-gray-500">Cek console browser untuk detail error.</p>
      <button
        class="px-4 py-2 bg-green-600 text-white rounded-lg text-sm"
        onclick={() => { loadError = false; resolveRoute(); }}
      >
        Coba Lagi
      </button>
    </div>
  {:else if !loaded}
    <div
      class="min-h-screen bg-[var(--color-bg)] flex flex-col items-center justify-center gap-3 text-[var(--color-muted-foreground)]"
    >
      <div
        class="w-8 h-8 border-2 border-[var(--color-primary)] border-t-transparent rounded-full animate-spin"
      ></div>
      <span class="text-xs uppercase font-bold tracking-widest">Memuat Halaman...</span>
    </div>
  {:else if PageComponent}
    {#if layout === 'none'}
      <PageComponent {...pageParams} />
    {:else if layout === 'admin'}
      <ProtectedRoute {permission}>
        <AdminLayout>
          <PageComponent {...pageParams} />
        </AdminLayout>
      </ProtectedRoute>
    {:else}
      <PublicLayout {activeNav}>
        <PageComponent {...pageParams} />
      </PublicLayout>
    {/if}
  {/if}
{/if}

<ToastHost />
